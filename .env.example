# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# Or use 1Password: task env:generate ENV=local

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_pass
DB_NAME=app_db

# Test Database (for pytest - uses same credentials, different database)
# Note: docker-compose.yml sets these automatically for container environments
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=app_user
TEST_DB_PASSWORD=app_pass
TEST_DB_NAME=app_db_test

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=development
