# Example .setup.config — generated by ./setup.sh
#
# Real .setup.config is gitignored. This file documents the schema for
# reference. Run ./setup.sh to generate yours; do not hand-edit unless you
# know what you're doing.

# Prefix for 1Password vaults. Vaults will be {PREFIX}-LOCAL, {PREFIX}-TEST,
# {PREFIX}-PROD.
VAULT_PREFIX=ACME

# Docker container prefix and compose project name (kebab-case).
APP_NAME=acme-app

# External port exposed on the host for the API (internal is always 8000).
EXTERNAL_PORT=8000

# Comma-separated optional sections seeded into each vault.
# Valid values: test, sentry, config
OPTIONAL_SECTIONS=test,sentry

# Wizard metadata.
WIZARD_VERSION=1
SETUP_DATE=2026-05-13T10:24:00Z
SETUP_COMPLETE=1
